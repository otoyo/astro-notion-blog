{
  "name": "astro-notion-blog",
  "type": "module",
  "version": "0.12.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "build:cached": "npm run cache:fetch && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "npx prettier --write .",
    "cache:fetch": "node scripts/blog-contents-cache.cjs",
    "cache:purge": "nx reset && rm -rf tmp/*",
    "_fetch-notion-blocks": "node scripts/retrieve-block-children.cjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/react": "^7.1.9",
    "@astrojs/rss": "^4.0.19",
    "@eslint/eslintrc": "^3.3.7",
    "@iconify-json/octicon": "^1.2.40",
    "@notionhq/client": "^5.31.1",
    "@supercharge/promise-pool": "^3.3.0",
    "astro": "^7.4.13",
    "astro-icon": "^1.2.0",
    "async-retry": "^1.3.3",
    "exif-be-gone": "^1.5.1",
    "katex": "^0.19.1",
    "mermaid": "^12.3.0",
    "metascraper": "^5.58.7",
    "metascraper-description": "^5.58.7",
    "metascraper-image": "^5.58.7",
    "metascraper-title": "^5.58.7",
    "prismjs": "^1.30.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nrwl/nx-cloud": "^19.1.5",
    "@types/async-retry": "^1.4.9",
    "@types/js-base64": "^3.3.1",
    "@types/katex": "^0.16.8",
    "@types/metascraper": "^5.41.0",
    "@types/metascraper-description": "^5.42.0",
    "@types/metascraper-image": "^5.42.0",
    "@types/metascraper-title": "^5.42.0",
    "@types/prismjs": "^1.26.6",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@typescript-eslint/typescript-estree": "^8.73.0",
    "cli-progress": "^3.12.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "nx": "^24.0.6",
    "typescript-eslint": "^8.73.0"
  },
  "nx": {
    "targets": {
      "_fetch-notion-blocks": {
        "cache": true,
        "inputs": [
          "{projectRoot}/scripts/blog-contents-cache.cjs",
          {
            "env": "DATABASE_ID"
          }
        ],
        "outputs": [
          "{projectRoot}/tmp"
        ]
      }
    },
    "includedScripts": [
      "_fetch-notion-blocks"
    ]
  },
  "optionalDependencies": {
    "@nx/nx-linux-x64-gnu": "24.0.6",
    "@rollup/rollup-linux-x64-gnu": "^4.68.7"
  }
}
